# Copy to .env for local use. The repository's ignored .env must contain the actual local values.
# `accounts` uses local file-backed accounts and HttpOnly sessions; this remains development-only.
AUTH_MODE=accounts
VITE_AUTH_MODE=accounts
ACCOUNTS_FILE=.local-data/accounts.json
MOCK_API_PORT=8787

# Local is always the default. Set VITE_API_MODE=aws only when intentionally testing the AWS HTTP API.
VITE_API_MODE=local
# AWS mode reads the exact HttpApiUrl output (including its /dev stage), no credential is placed here.
# VITE_API_MODE=aws
# VITE_HTTP_API_URL=
# OIDC_AUDIENCE is the SAM OidcAudience value and must exactly match VITE_GOOGLE_CLIENT_ID.
# SAM FrontendOrigin must match the browser origin exactly (scheme, hostname, and port).
# SAM GoogleAdminSubjects is a comma-separated list of approved Google `sub` identifiers; never accept it from a browser.
# Optional voter-link origin for QR/link sharing; leave blank to use the current browser origin.
# For a non-local deployment, set this to the reachable frontend origin (for example https://ballot.example).
VITE_APP_ORIGIN=

# Required only when each predefined admin account is first initialized.
# Choose private values locally; these are placeholders, not working passwords.
INITIAL_ADMIN_SAMARTH_PASSWORD=SET_ME
INITIAL_ADMIN_VISHWAS_PASSWORD=SET_ME
INITIAL_ADMIN_SRIRAM_PASSWORD=SET_ME

# Optional mock preview (never use as authentication): set both modes to development.
# AUTH_MODE=development
# VITE_AUTH_MODE=development

# For the local Google backend only, set AUTH_MODE and VITE_AUTH_MODE to google. AWS API mode is separate and opt-in.
GOOGLE_CLIENT_ID=SET_GOOGLE_WEB_CLIENT_ID_LOCALLY
VITE_GOOGLE_CLIENT_ID=SET_GOOGLE_WEB_CLIENT_ID_LOCALLY

# Comma-separated, backend-only Google `sub` identifiers. Leave empty until explicitly assigned.
GOOGLE_ADMIN_SUBJECTS=

# Local Google backend mode: set AUTH_MODE and VITE_AUTH_MODE to google. AWS mode is selected separately with VITE_API_MODE=aws.
