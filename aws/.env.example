# Example only. Never commit real secrets or AWS credentials.
AWS_REGION=ap-south-1
TABLE_NAME=BallotData-dev
HTTP_API_BASE_URL=https://replace-after-deployment.execute-api.ap-south-1.amazonaws.com
WEBSOCKET_API_URL=wss://replace-after-deployment.execute-api.ap-south-1.amazonaws.com/dev
WEBSOCKET_MANAGEMENT_ENDPOINT=https://replace-after-deployment.execute-api.ap-south-1.amazonaws.com/dev

# Google OIDC; audience is the Google OAuth Web client ID (not a secret).
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=SET_GOOGLE_WEB_CLIENT_ID_LOCALLY
# Backend-only list of verified Google `sub` values authorized as administrators.
GOOGLE_ADMIN_SUBJECTS=SET_GOOGLE_SUBJECTS_LOCALLY

# Required backend-only HMAC key. Generate locally at deployment time; do not commit it.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
VOTER_KEY_SECRET=SET_LOCALLY_DURING_APPROVED_DEPLOYMENT
VOTE_SHARD_COUNT=4
RESULT_SHARD_COUNT=4
CONNECTION_SHARD_COUNT=4
CONNECTION_TICKET_TTL_SECONDS=90
CHAT_MAX_LENGTH=500
