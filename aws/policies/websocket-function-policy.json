{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PollConnectionAndChatItems",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:TransactWriteItems"],
      "Resource": "<TABLE_ARN>"
    },
    {
      "Sid": "BroadcastToThisWebSocketStage",
      "Effect": "Allow",
      "Action": "execute-api:ManageConnections",
      "Resource": "<WEBSOCKET_API_ARN>/dev/POST/@connections/*"
    },
    {
      "Sid": "WriteOnlyWebSocketFunctionLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "<WEBSOCKET_LOG_GROUP_ARN>:*"
    }
  ]
}
